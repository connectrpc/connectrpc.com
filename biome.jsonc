{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.ssg-cache",
      "!**/build",
      // Biome lacks .astro support; the toolchain handles formatting via Astro itself.
      "!**/*.astro",
      // Skip Go vanity URL HTML files.
      "!public/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "includes": ["**"],
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "overrides": [
    {
      // Biome 2.5 began linting standalone .svg assets. Both rules below target
      // SVG inlined into markup, where the usage site decides whether a graphic
      // is decorative or meaningful; an asset file on its own has no usage site
      // to judge. Ours are either referenced through <img alt> or inlined by
      // components that set aria-hidden/aria-label themselves. Most are also
      // vendored brand assets, so edits here would be lost on the next refresh.
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          },
          "correctness": {
            "noUnknownProperty": "off"
          }
        }
      }
    }
  ]
}
