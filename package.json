{
  "name": "connect-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro node_modules/.astro .rumdl_cache",
    "astro": "astro",
    "check:types": "astro check && tsc --noEmit",
    "format": "npm run format:src && npm run format:md",
    "format:src": "biome format --write .",
    "format:md": "rumdl fmt .",
    "lint": "npm run lint:src && npm run lint:md",
    "lint:src": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:md": "rumdl check .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "license-header": "license-header",
    "ci": "npm run build && npm run check:fix && rumdl fmt . --deny-config-warnings && npm run lint:md && npm run check:types && npm run license-header",
    "publish": "npm install && npm run lint && npm run check:types && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@buf/connectrpc_eliza.bufbuild_es": "^2.2.2-20230913231627-233fca715f49.2",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@react-hookz/web": "^26.1.0",
    "astro": "^7.1.6",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-custom-heading-id": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@biomejs/biome": "2.6.4",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/license-header": "^0.0.4",
    "@dprint/ruff": "0.11.3",
    "@dprint/shfmt": "0.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dprint": "0.64.3",
    "rumdl": "^0.3.2",
    "typescript": "^6.0.3"
  },
  "licenseHeader": {
    "licenseType": "apache",
    "yearRange": "2021-2026",
    "copyrightHolder": "The Connect Authors"
  },
  "engines": {
    "node": ">=24"
  }
}
